@startuml thiet-ke-lop-thuc-the
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam ArrowColor #1F5C7A
skinparam nodesep 30
skinparam ranksep 45
skinparam linetype ortho
hide circle
hide empty members
skinparam class {
  BorderColor #1F5C7A
  BackgroundColor White
}
skinparam class<<data>> {
  BackgroundColor #EEF6FB
}
skinparam class<<enum>> {
  BackgroundColor #F6F1FA
  BorderColor #7A4F9A
}
skinparam package {
  BorderColor #1F5C7A
  BackgroundColor #FBFDFE
  FontColor #1F5C7A
}

title Thiết kế lớp thực thể - Survival Action

' =====================================================================
package "Nhân vật" {
  abstract class Entity {
    # currentHP : float
    + CanBeHit : bool
    + TakeDamage(info : DamageInfo) : void
    + ApplySlow(amount : float, duration : float) : void
    # Die() : void
  }

  abstract class Player {
    - state : PlayerState
    + aimDirection : Vector2
    + moveDirection : Vector2
    + isInvincible : bool
    + BonusPierce : int
    + Heal(amount : float) : void
    + ApplyStatModifier(stat : StatType, value : float, kind : StatModifierKind) : void
    + ModifyOutgoingDamage(damage : float) : float
    + RollSpellEcho(type : DamageType) : bool
    + OnLevelChanged(level : int) : void
    # OnDamaged(info : DamageInfo, taken : float) : void
  }

  class Swordsman {
    - critChance : float
    - critDamage : float
  }
  class Archer {
    - bonusPierce : int
    - passiveMultishot : int
  }
  class Mage {
    - spellEchoChance : float
    - passiveAttackSpeed : float
  }
  class Guardian {
    - thornsRatio : float
    - maxThornsDamage : float
    - passiveMaxHP : float
  }

  class PlayerStats <<data>> {
    + maxHP : float
    + recovery : float
    + armor : float
    + moveSpeed : float
    + might : float
    + attackSpeed : float
    + area : float
    + multishot : int
    + magnet : float
    + projectileSpeed : float
    + duration : float
    + growth : float
    + greed : float
    + revival : int
    + Get(stat : StatType) : float
    + Add(stat : StatType, amount : float) : void
  }

  class CharacterData <<data>> {
    + id : string
    + displayName : string
    + description : string
    + portrait : Sprite
    + baseMoveSpeed : float
    + revivalHealthRatio : float
    + armorReductionPerPoint : float
    + maxArmorReduction : float
  }

  class PlayerInventory {
    + maxWeapons : int
    + maxPassives : int
    + AddWeapon(data : WeaponData) : void
    + EvolveWeapon(weapon : Weapon) : void
    + AddPassive(data : PassiveItemData) : void
    + HasWeapon(data : WeaponData) : bool
    + HasPassive(data : PassiveItemData) : bool
  }

  class PlayerProgression {
    + level : int
    + currentXP : float
    + requiredXP : float
    + runGold : int
    + pendingLevelUps : int
    + AddXP(amount : float) : void
    + AddGold(amount : int) : void
  }

  class Hurtbox {
    + owner : Entity
    + collider : Collider2D
  }
}

' =====================================================================
package "Vũ khí và vật phẩm" {
  abstract class Weapon {
    + level : int
    + IsMaxLevel : bool
    + CanEvolve(inventory : PlayerInventory) : bool
    + LevelUp() : void
    # Attack(direction : Vector2) : void
    # CreateDamage(knockbackDirection : Vector2) : DamageInfo
  }
  class SwordSlash
  class ProjectileWeapon
  class LightningStrike
  class OrbitingOrbs
  class ZoneWeapon {
    - placement : ZonePlacement
  }
  class SoulBlades

  class WeaponData <<data>> {
    + id : string
    + displayName : string
    + description : string
    + icon : Sprite
    + aimMode : AimMode
    + damageType : DamageType
    + isStartingWeapon : bool
    + playOwnerAttackAnim : bool
    + MaxLevel : int
  }

  class WeaponLevelStats <<data>> {
    + damage : float
    + attackInterval : float
    + size : float
    + projectiles : int
    + arcAngle : float
    + knockback : float
    + projectileSpeed : float
    + range : float
    + pierce : int
    + impactRadius : float
    + burstInterval : float
    + slowAmount : float
    + slowDuration : float
    + duration : float
    + chainCount : int
    + pullStrength : float
    + upgradeDescription : string
  }

  class Projectile {
    - motion : ProjectileMotion
    - speed : float
    - distanceLeft : float
    - pierceLeft : int
    - impactRadius : float
    + Launch(shot : ProjectileShot) : void
  }

  class DamageZone {
    - radius : float
    - remainingTime : float
    - pullStrength : float
    + Activate(position : Vector2, radius : float, lifetime : float) : void
  }

  class PassiveItemData <<data>> {
    + id : string
    + displayName : string
    + description : string
    + icon : Sprite
    + stat : StatType
    + modifierKind : StatModifierKind
    + valuePerLevel : float
    + maxLevel : int
  }

  class PassiveItem {
    + level : int
    + IsMaxLevel : bool
    + LevelUp() : void
  }

  class StatCardData <<data>> {
    + id : string
    + displayName : string
    + description : string
    + icon : Sprite
    + stat : StatType
    + modifierKind : StatModifierKind
    + value : float
    + maxPicks : int
    + healAmount : float
  }

  class UpgradeOption {
    + kind : UpgradeKind
    + title : string
    + description : string
    + icon : Sprite
  }

  class DamageInfo <<data>> {
    + amount : float
    + type : DamageType
    + knockback : Vector2
    + source : Entity
  }

  class HitEffect <<data>> {
    + slowAmount : float
    + slowDuration : float
  }
}

' =====================================================================
package "Quái" {
  abstract class Enemy {
    - state : EnemyState
    - moveSpeed : float
    - attackDamage : float
    - attackCooldown : float
    - slowAmount : float
    - travelDirection : Vector2
    + Init(data : EnemyData, difficulty : DifficultyData) : void
    + Tick(playerPosition : Vector2, deltaTime : float) : void
    + AddPull(velocity : Vector2) : void
  }
  class ChaserEnemy
  class RangedEnemy {
    - retreatRange : float
    - fireInterval : float
    - projectileDamage : float
  }
  class ChargerEnemy {
    - chargeRange : float
    - windupTime : float
    - chargeSpeed : float
  }
  class ExploderEnemy {
    - triggerRange : float
    - fuseTime : float
    - explosionRadius : float
  }
  abstract class BossEnemy {
    - phase : int
  }
  class WerebearBoss
  class NecromancerBoss

  class EnemyData <<data>> {
    + id : string
    + displayName : string
    + maxHP : float
    + moveSpeed : float
    + mass : float
    + attackDamage : float
    + attackInterval : float
    + attackRange : float
    + attackHitTime : float
    + armorPercent : float
    + magicResistPercent : float
    + knockbackResist : float
    + xpDrop : int
    + coinDropChance : float
    + coinAmount : int
    + dropsChest : bool
  }

  class Pickup {
    + kind : PickupKind
    + value : int
  }
}

' =====================================================================
package "Cấu hình ván chơi" {
  class DifficultyData <<data>> {
    + id : string
    + displayName : string
    + scoreMultiplier : float
    + hpMultiplier : float
    + damageMultiplier : float
    + speedMultiplier : float
    + spawnRateMultiplier : float
    + maxAliveMultiplier : float
    + goldMultiplier : float
  }

  class RunScriptData <<data>> {
    + runDuration : float
    + shopTimes : float[]
  }

  class WaveData <<data>> {
    + startTime : float
    + spawnInterval : float
    + spawnPerTick : int
    + minAlive : int
    + maxAlive : int
    + PickEnemy() : EnemyData
  }

  class WeightedEnemy <<data>> {
    + weight : float
  }

  class SpawnEvent <<data>> {
    + time : float
    + pattern : SpawnPattern
    + count : int
    + duration : float
    + spread : float
  }

  class ProgressionConfig <<data>> {
    + baseRequiredXP : float
    + requiredXPPerLevel : float
    + choiceCount : int
    + maxStatCardsPerRoll : int
    + maxWeapons : int
    + maxPassives : int
  }

  class ScoreConfig <<data>> {
    + pointsPerSecond : float
    + pointsPerKillXP : float
    + victoryBonus : int
  }

  class ShopConfig <<data>> {
    + slotCount : int
    + rerollBaseCost : int
    + rerollCostStep : int
    + refundRatio : float
  }

  class ShopItemData <<data>> {
    + id : string
    + displayName : string
    + type : ShopItemType
    + basePrice : int
    + pricePerLevel : int
    + maxPerRun : int
    + weight : float
  }
}

' =====================================================================
package "Tài khoản và lưu trữ" {
  class UserAccount {
    + uid : string
    + email : string
    + displayName : string
    + isAnonymous : bool
    + isEmailVerified : bool
  }

  class AccountData <<data>> {
    + version : int
    + accountGold : int
    + unlockedWeaponIds : string[]
    + createdAt : DateTime
    + updatedAt : DateTime
  }

  class SettingsData <<data>> {
    + bgmVolume : float
    + sfxVolume : float
    + showHealthBar : bool
  }

  class RunResult <<data>> {
    + score : int
    + runTime : float
    + kills : int
    + level : int
    + victory : bool
    + difficultyId : string
    + characterId : string
    + timestamp : string
  }

  class LeaderboardEntry <<data>> {
    + uid : string
    + displayName : string
    + score : int
    + difficultyId : string
    + characterId : string
    + runTime : float
    + kills : int
    + level : int
    + victory : bool
    + achievedAt : DateTime
  }

  class RunSaveData <<data>> {
    + version : int
    + savedAtUtc : string
    + runTime : float
    + difficultyId : string
    + characterId : string
    + nextShopIndex : int
    + nextSpawnEventIndex : int
    + playerPosition : Vector2
    + currentHP : float
    + level : int
    + currentXP : float
    + runGold : int
    + kills : int
    + killedXP : int
  }

  class OwnedItemData <<data>> {
    + id : string
    + level : int
    + evolved : bool
  }

  class EnemySaveData <<data>> {
    + enemyId : string
    + position : Vector2
    + currentHP : float
  }

  class PickupSaveData <<data>> {
    + kind : PickupKind
    + position : Vector2
    + value : int
  }
}

' =====================================================================
package "Kiểu liệt kê" {
  enum DamageType <<enum>> {
    Physical
    Magic
  }
  enum StatType <<enum>> {
    MaxHP
    Recovery
    Armor
    MoveSpeed
    Might
    AttackSpeed
    Area
    Multishot
    Magnet
    ProjectileSpeed
    Duration
    Growth
    Greed
    Revival
  }
  enum StatModifierKind <<enum>> {
    Flat
    PercentOfBase
  }
  enum AimMode <<enum>> {
    Cursor
    NearestEnemy
    RandomEnemy
    Orbit
    Trail
    Omni
  }
  enum ProjectileMotion <<enum>> {
    Straight
    Boomerang
    Homing
  }
  enum ZonePlacement <<enum>> {
    AtOwner
    RandomEnemy
  }
  enum SpawnPattern <<enum>> {
    Ring
    Line
    Swarm
    Boss
    Pause
  }
  enum UpgradeKind <<enum>> {
    NewWeapon
    WeaponLevel
    NewPassive
    PassiveLevel
    StatCard
    Evolution
    Fallback
  }
  enum PickupKind <<enum>> {
    Gem
    Coin
    Chest
  }
  enum ShopItemType <<enum>> {
    NewWeapon
    WeaponLevel
    NewPassive
    PassiveLevel
    Potion
    ShopOnlyStat
    MysteryChest
  }
}

' ============================ Kế thừa ================================
Entity <|-- Player
Entity <|-- Enemy
Player <|-- Swordsman
Player <|-- Archer
Player <|-- Mage
Player <|-- Guardian

Enemy <|-- ChaserEnemy
Enemy <|-- RangedEnemy
Enemy <|-- ChargerEnemy
Enemy <|-- ExploderEnemy
Enemy <|-- BossEnemy
BossEnemy <|-- WerebearBoss
BossEnemy <|-- NecromancerBoss

Weapon <|-- SwordSlash
Weapon <|-- ProjectileWeapon
Weapon <|-- LightningStrike
Weapon <|-- OrbitingOrbs
Weapon <|-- ZoneWeapon
Weapon <|-- SoulBlades

' ============================ Nhân vật ===============================
Player "1" *-- "1" PlayerStats : stats
Player "1" *-- "1" PlayerInventory : inventory
Player "1" --> "1" CharacterData : data
Player "1" *-- "1" Hurtbox
Enemy "1" *-- "1" Hurtbox
Hurtbox "*" --> "1" Entity : owner
CharacterData "1" *-- "1" PlayerStats : baseStats
CharacterData "*" --> "1" WeaponData : startingWeapon
CharacterData "*" o-- "4" WeaponData : weaponPool
CharacterData "*" o-- "7" PassiveItemData : passivePool

PlayerInventory "1" o-- "1..4" Weapon : weapons
PlayerInventory "1" o-- "0..4" PassiveItem : passives

' ============================ Vũ khí =================================
Weapon "*" --> "1" WeaponData : data
Weapon "*" --> "1" WeaponData : sourceData
Weapon "*" --> "1" Player : owner
WeaponData "1" *-- "1..5" WeaponLevelStats : levels
WeaponData "0..1" --> "0..1" WeaponData : evolution
WeaponData "*" --> "0..1" PassiveItemData : evolutionItem
WeaponData "*" --> "0..1" Projectile : projectilePrefab
ZoneWeapon "1" o-- "0..*" DamageZone : zones
Projectile ..> DamageInfo
Projectile ..> HitEffect
DamageZone ..> DamageInfo
DamageInfo "*" --> "1" Entity : source

PassiveItem "*" --> "1" PassiveItemData : data
UpgradeOption "*" --> "0..1" WeaponData
UpgradeOption "*" --> "0..1" Weapon
UpgradeOption "*" --> "0..1" PassiveItemData
UpgradeOption "*" --> "0..1" PassiveItem
UpgradeOption "*" --> "0..1" StatCardData

' ============================ Quái ===================================
Enemy "*" --> "1" EnemyData : data
Enemy ..> DifficultyData : hệ số khi spawn
EnemyData ..> Pickup : rơi ra

' ============================ Cấu hình ván ===========================
RunScriptData "1" *-- "1..*" WaveData : waves
RunScriptData "1" *-- "0..*" SpawnEvent : events
WaveData "1" *-- "1..*" WeightedEnemy : enemies
WeightedEnemy "*" --> "1" EnemyData : enemy
SpawnEvent "*" --> "0..1" EnemyData : enemy
ProgressionConfig "1" o-- "*" StatCardData : statCards
ShopItemData ..> WeaponData
ShopItemData ..> PassiveItemData

' ============================ Tài khoản ==============================
UserAccount "1" *-- "1" AccountData : hồ sơ
AccountData "1" *-- "1" SettingsData : settings
AccountData "1" *-- "0..10" RunResult : recentRuns
UserAccount "1" -- "0..1" LeaderboardEntry : kết quả tốt nhất
UserAccount "1" *-- "0..1" RunSaveData : runSave
RunSaveData "1" *-- "1" PlayerStats : stats
RunSaveData "1" *-- "1..4" OwnedItemData : weapons
RunSaveData "1" *-- "0..4" OwnedItemData : passives
RunSaveData "1" *-- "0..*" EnemySaveData : enemies
RunSaveData "1" *-- "0..*" PickupSaveData : pickups
RunResult ..> DifficultyData : difficultyId
RunResult ..> CharacterData : characterId

@enduml
