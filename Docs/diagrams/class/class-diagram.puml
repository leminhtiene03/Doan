@startuml class-diagram
title Survival Action - Design class diagram
skinparam classAttributeIconSize 0
set separator none
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

' ===================== Core =====================
package "Game.Core" {
  abstract class Entity {
    + CurrentHP : float
    + {abstract} TakeDamage(info : DamageInfo)
    # {abstract} Die()
  }

  class DamageInfo <<struct>> {
    + Amount : float
    + Type : DamageType
    + Knockback : Vector2
    + Source : Entity
  }

  enum DamageType {
    Physical
    Magic
  }

  enum GameState {
    Playing
    Paused
    LevelUp
    Shop
    BossFight
    Victory
    GameOver
  }

  class GameManager <<singleton>> {
    + State : GameState
    + RunTime : float
    + OnStateChanged : event
    + EnterLevelUp()
    + ResumePlaying()
    + OpenShop()
    + Pause()
    + StartBossFight()
    + Win()
    + RestartRun()
    + ExitToMainMenu()
  }

  class PoolManager <<singleton>> {
    - poolsByPrefab : Dictionary
    + Get<T>(prefab, position, rotation) : T
    + Release(instance)
    + Prewarm(prefab, count)
  }

  class PooledEffect {
    - lifetime : float
  }

  class SceneLoader <<static>> {
    + LoadMainMenu()
    + LoadCharacterSelect()
    + LoadDifficultySelect()
    + LoadRun()
    + ReloadCurrent()
  }
}

' ===================== Player =====================
package "Game.Player" {
  abstract class Player {
    - data : CharacterData
    - state : PlayerState
    + Stats : PlayerStats
    + Inventory : PlayerInventory
    + Skill : Skill
    + AimDirection : Vector2
    + MoveDirection : Vector2
    + OnHealthChanged : event
    + OnStatsChanged : event
    + OnDeath : event
    + TakeDamage(info : DamageInfo)
    + Heal(amount : float)
    + ApplyStatModifier(stat, value, kind)
    + PlayAttackAnimation(interval : float)
    + ModifyOutgoingDamage(damage : float) : float
    + OnDamageTaken(damage : float, source : Entity)
    + OnWeaponFired(weapon : Weapon)
    + OnProjectileSpawned(projectile : Projectile)
    + GetClassStats(results)
    # {abstract} ApplyLevelPassive(level : int)
  }

  enum PlayerState {
    Idle
    Move
    UsingSkill
    Dead
  }

  class Swordsman {
    - critChance : float
    - critDamage : float
  }
  class Archer {
    - bonusPierce : int
  }
  class Mage {
    - spellEchoChance : float
  }
  class Guardian {
    - thornsRatio : float
  }

  class PlayerStats {
    - maxHP, recovery, armor, moveSpeed, might
    - attackSpeed, area, multishot, magnet
    - projectileSpeed, duration, growth, greed
    - revival, cooldown
    + Get(stat : StatType) : float
    + Add(stat : StatType, amount : float)
    + Clone() : PlayerStats
  }

  class PlayerInventory {
    + Weapons : List<Weapon>
    + Passives : List<PassiveItem>
    + AddWeapon(data : WeaponData)
    + RemoveWeapon(weapon : Weapon)
    + EvolveWeapon(weapon : Weapon)
    + AddPassive(data : PassiveItemData)
    + LevelUpPassive(passive : PassiveItem)
    + RemovePassive(passive : PassiveItem)
    + TickWeapons(deltaTime : float)
  }

  class PassiveItem {
    + Data : PassiveItemData
    + Level : int
    + LevelUp()
  }
}

' ===================== Skills =====================
package "Game.Skills" {
  abstract class Skill {
    # data : SkillData
    # owner : Player
    + Level : int
    + IsEvolved : bool
    + CooldownRemaining : float
    + Tick(deltaTime : float)
    + TryActivate() : bool
    + LevelUp()
    + CanEvolve(stats : PlayerStats) : bool
    + Evolve()
    # {abstract} Activate()
  }
  class SwordWave
  class ArrowRain
  class TripleFireball
  class SuppressionAura {
    + Burst()
  }
}

' ===================== Weapons =====================
package "Game.Weapons" {
  abstract class Weapon {
    - cooldownTimer : float
    + Data : WeaponData
    + Level : int
    + IsEvolved : bool
    # Owner : Player
    + Equip(owner : Player, data : WeaponData)
    + LevelUp()
    + Evolve(evolved : WeaponData)
    + Tick(deltaTime : float)
    # GetAttackDirection() : Vector2
    # CreateDamage(direction : Vector2) : DamageInfo
    # {abstract} Attack(direction : Vector2)
  }

  abstract class MeleeArcWeapon {
    # HitEnemiesInArc(origin, direction, range, arcAngle)
  }
  class SwordSlash
  class HeavyStrike

  abstract class ProjectileWeapon {
    # FireFan(direction : Vector2, count : int)
  }
  class WoodenBow
  class ArcaneBolt
  class ThrowingDagger
  class IceShard
  class SpiritSword
  class BoomerangWeapon

  class Caltrops
  class OrbitingOrbs
  class LightningStrike
  class PoisonFlask

  class Projectile {
    - direction : Vector2
    - speed : float
    - range : float
    - remainingHits : int
    - hitEnemies : HashSet<Enemy>
    + Launch(direction, speed, damage, type, range)
    + AddPierce(amount : int)
    + Tick(deltaTime : float) : bool
    # Move(deltaTime : float)
  }
  class HomingProjectile
  class BoomerangProjectile

  class ProjectileManager {
    - active : List<Projectile>
    + Register(projectile : Projectile)
  }

  class DamageZone {
    - radius : float
    - tickInterval : float
    - lifetime : float
    - slowRatio : float
    + Init(position, radius, damage, lifetime)
    + Tick(deltaTime : float) : bool
  }

  class DamageZoneManager {
    - active : List<DamageZone>
    + Register(zone : DamageZone)
  }
}

' ===================== Enemies =====================
package "Game.Enemies" {
  class Enemy {
    # state : EnemyState
    + Data : EnemyData
    + ListIndex : int
    + CanBeHit : bool
    + OnDeath : event
    + Init(data : EnemyData, difficulty : DifficultyData)
    + Restore(data : EnemyData, hp : float)
    + Tick(playerPosition : Vector2, deltaTime : float)
    + TryContact(playerPosition : Vector2) : bool
    + CreateContactDamage() : DamageInfo
    + TakeDamage(info : DamageInfo)
    + ApplySlow(ratio : float, duration : float)
    + Teleport(position : Vector2)
    # TickBehavior(playerPosition, deltaTime)
  }

  enum EnemyState {
    Spawning
    Chase
    Attack
    Dead
  }

  class RangedEnemy {
    - attackRange, retreatRange : float
    - fireInterval : float
  }
  class ChargerEnemy {
    - chargeRange, windupTime : float
    - chargeSpeed, chargeDuration : float
  }
  class ExploderEnemy {
    - triggerRange, fuseTime : float
    - explosionDamage, explosionRadius : float
  }

  abstract class BossEnemy {
    # phase : int
    # {abstract} RunAttackCycle(deltaTime : float)
  }
  class WerebearBoss {
    - slamRadius, slamDamage : float
    - chargeDistance, chargeSpeed : float
  }
  class NecromancerBoss {
    - summonInterval, volleyInterval : float
    - teleportInterval, phaseTwoThreshold : float
  }

  class EnemyProjectile {
    - damage : float
    - speed : float
    + Tick(playerPosition, deltaTime) : bool
  }

  class EnemyManager <<singleton>> {
    - active : List<Enemy>
    + Active : IReadOnlyList<Enemy>
    + OnEnemyDied : event
    + Spawn(data : EnemyData, position : Vector2) : Enemy
    + Despawn(enemy : Enemy)
    + KillAll()
    + FindNearest(from, range) : Enemy
    + FindRandom(from, range) : Enemy
    + GetOffscreenPosition() : Vector2
  }
}

' ===================== Spawning =====================
package "Game.Spawning" {
  class SpawnManager {
    - runScript : RunScript
    - difficulty : DifficultyData
    - nextEventIndex : int
    - spawnTimer : float
    + Tick(runTime : float, deltaTime : float)
    - SpawnFromWave(wave : WaveData)
    - RunEvent(spawnEvent : SpawnEvent)
  }

  class SpawnPatterns <<static>> {
    + {static} Ring(enemy, count, radius)
    + {static} Line(enemy, count, direction)
    + {static} Swarm(enemy, count, direction)
  }
}

' ===================== Progression =====================
package "Game.Progression" {
  class PlayerProgression {
    + Level : int
    + CurrentXP : float
    + RequiredXP : float
    + Gold : int
    + PendingLevelUps : int
    + OnXPChanged : event
    + OnLevelChanged : event
    + OnGoldChanged : event
    + OnLevelUpReady : event
    + AddXP(amount : float)
    + AddGold(amount : int)
    + TrySpendGold(amount : int) : bool
    + ConsumePendingLevelUp()
  }

  class Pickup {
    + Kind : PickupKind
    + Value : int
    + IsAttracted : bool
    + Init(value : int)
    + AddValue(amount : int)
  }

  enum PickupKind {
    Gem
    Coin
    Chest
  }

  class PickupManager {
    - active : List<Pickup>
    - gemCount : int
    - HandleEnemyDied(enemy : Enemy)
    - TryMergeIntoNearestGem(position, value) : bool
    - Collect(pickup : Pickup)
  }

  class LevelUpManager {
    - statCardPicks : Dictionary<StatCardData, int>
    + OnOptionsReady : event
    + OnClosed : event
    + ChooseUpgrade(index : int)
    + OpenChest()
    - RollOptions()
    - BuildCandidates()
  }

  class UpgradeOption {
    + Kind : UpgradeKind
    + Title : string
    + Description : string
    + Icon : Sprite
  }

  enum UpgradeKind {
    NewWeapon
    WeaponLevel
    NewPassive
    PassiveLevel
    SkillLevel
    StatCard
    Evolution
    Fallback
  }

  class UpgradeApplier {
    + Apply(option : UpgradeOption)
  }

  class RunScoreTracker {
    + Kills : int
    + KilledXP : int
    + OnRunFinished : event
    + CalculateScore(runTime : float, victory : bool) : int
  }

  class RunResult {
    - score : int
    - runTime : float
    - kills : int
    - level : int
    - victory : bool
    - difficultyId : string
    - characterId : string
    - timestamp : string
  }
}

' ===================== Shop =====================
package "Game.Shop" {
  class ShopManager {
    - stock : ShopSlot[5]
    - rerollCost : int
    - limitedPurchases : Dictionary<string, int>
    + OnStockChanged : event
    + Open()
    + Close()
    + Buy(slot : int)
    + Reroll()
    + RequestDiscard(item)
    + ConfirmDiscard(item)
    - GenerateStock()
    - CalculateRefund(item) : int
  }

  class ShopSlot {
    + Item : ShopItemData
    + Target : string
    + Price : int
    + Sold : bool
  }

  class WeaponUnlockService {
    + IsUnlocked(weapon : WeaponData) : bool
    + TryUnlock(weapon : WeaponData) : bool
  }
}

' ===================== Save =====================
package "Game.Save" {
  class SaveService {
    + HasRunSave() : bool
    + SaveRunAndExit()
    + LoadRun() : RunSaveData
    + SaveAccount()
    + FinishRun(result : RunResult)
  }

  interface ISaveStore {
    + LoadAccount() : AccountSaveData
    + SaveAccount(data : AccountSaveData)
    + LoadRunSave() : RunSaveData
    + SaveRunSave(data : RunSaveData)
    + DeleteRunSave()
  }
  class LocalJsonStore
  class FirestoreStore

  class AuthService {
    + UserId : string
    + DisplayName : string
    + SignInAnonymously()
  }

  class LeaderboardService {
    + SubmitResult(result : RunResult)
    + GetTop(count : int) : List<LeaderboardEntry>
    + GetRank(score : int) : int
  }

  class LeaderboardEntry {
    + UserId : string
    + DisplayName : string
    + Result : RunResult
  }

  class RunSaveData {
    + version : int
    + run : RunStateData
    + player : PlayerSaveData
    + inventory : InventorySaveData
    + skill : SkillSaveData
    + progression : ProgressionSaveData
    + score : ScoreSaveData
    + shop : ShopSaveData
    + enemies : EnemySaveData[]
    + pickups : PickupSaveData[]
  }

  class AccountSaveData {
    + version : int
    + accountGold : int
    + unlockedWeaponIds : string[]
    + settings : SettingsSaveData
    + recentRuns : RunResult[10]
  }
}

' ===================== Data (ScriptableObject) =====================
package "Game.Data" {
  class CharacterData <<ScriptableObject>> {
    + Id : string
    + BaseMoveSpeed : float
    + BaseStats : PlayerStats
    + StartingWeapon : WeaponData
    + StartingSkill : SkillData
    + Prefab : Player
  }

  class WeaponData <<ScriptableObject>> {
    + Id : string
    + Icon : Sprite
    + AimMode : AimMode
    + DamageType : DamageType
    + IsStartingWeapon : bool
    + Levels : WeaponLevelStats[5]
    + RequiredPassive : PassiveItemData
    + EvolvedWeapon : WeaponData
  }

  class WeaponLevelStats <<struct>> {
    + Damage, AttackInterval, Size : float
    + Projectiles : int
    + ArcAngle, Knockback : float
  }

  enum AimMode {
    Cursor
    NearestEnemy
    RandomEnemy
    Orbit
    Trail
    Omni
  }

  class SkillData <<ScriptableObject>> {
    + Id : string
    + BaseCooldown : float
    + DamageType : DamageType
    + Levels : SkillLevelStats[5]
    + EvolveStat : StatType
    + EvolveThreshold : float
  }

  class EnemyData <<ScriptableObject>> {
    + Id : string
    + Prefab : Enemy
    + MaxHP, MoveSpeed : float
    + ContactDamage, ContactRadius : float
    + ArmorPercent, MagicResistPercent : float
    + KnockbackResist : float
    + XpDrop : int
    + CoinDropChance : float
    + DropsChest : bool
  }

  class PassiveItemData <<ScriptableObject>> {
    + Id : string
    + Stat : StatType
    + ModifierKind : StatModifierKind
    + ValuePerLevel : float
    + MaxLevel : int
  }

  class StatCardData <<ScriptableObject>> {
    + Id : string
    + Stat : StatType
    + ModifierKind : StatModifierKind
    + Value : float
    + MaxPicks : int
  }

  enum StatType {
    MaxHP, Recovery, Armor, MoveSpeed
    Might, AttackSpeed, Area, Multishot
    Magnet, ProjectileSpeed, Duration
    Growth, Greed, Revival, Cooldown
  }

  class DifficultyData <<ScriptableObject>> {
    + Id : string
    + HpMul, DamageMul, SpeedMul : float
    + SpawnRateMul, MaxAliveMul : float
    + GoldMul : float
    + BaseScore : int
    + ScoreMultiplier : float
  }

  class RunScript <<ScriptableObject>> {
    + RunDuration : float
    + ShopTimes : float[]
    + Waves : WaveData[]
    + Events : SpawnEvent[]
    + FinalBoss : EnemyData
  }

  class WaveData {
    + StartTime, EndTime : float
    + Enemies : WeightedEnemy[]
    + SpawnInterval : float
    + MaxAlive : int
  }

  class SpawnEvent {
    + Time : float
    + Pattern : SpawnPattern
    + Enemy : EnemyData
    + Count : int
    + Duration : float
  }

  enum SpawnPattern {
    Ring
    Line
    Swarm
    Boss
    Pause
  }

  class ShopItemData <<ScriptableObject>> {
    + Id : string
    + Type : ShopItemType
    + BasePrice, PricePerLevel : int
    + MaxPerRun : int
    + Weight : int
  }

  class ProgressionConfig <<ScriptableObject>> {
    + ChoiceCount, MaxStatCardsPerRoll : int
    + MaxWeapons, MaxPassives : int
    + AttractSpeed, CollectRadius : float
    + MaxGemsOnMap : int
    + GetRequiredXP(level : int) : float
  }

  class ScoreConfig <<ScriptableObject>> {
    + PointsPerSecond : float
    + PointsPerKillXP : float
    + VictoryBonus : int
  }

  class ShopConfig <<ScriptableObject>> {
    + SlotCount : int
    + RerollBaseCost, RerollCostStep : int
    + RefundRatio : float
  }

  class RunSelection <<ScriptableObject>> {
    + Character : CharacterData
    + Difficulty : DifficultyData
    + Clear()
  }

  class GameDatabase <<ScriptableObject>> {
    + FindCharacter(id) : CharacterData
    + FindWeapon(id) : WeaponData
    + FindEnemy(id) : EnemyData
    + FindPassive(id) : PassiveItemData
  }
}

' ===================== UI =====================
package "Game.UI" {
  class HudView
  class LevelUpPanel
  class StatsPanelView
  class ShopView
  class GameOverView
  class MainMenuView
  class CharacterSelectView
  class DifficultySelectView
  class LeaderboardView
}

' ===================== Inheritance =====================
Entity <|-- Player
Entity <|-- Enemy
Player <|-- Swordsman
Player <|-- Archer
Player <|-- Mage
Player <|-- Guardian

Skill <|-- SwordWave
Skill <|-- ArrowRain
Skill <|-- TripleFireball
Skill <|-- SuppressionAura

Weapon <|-- MeleeArcWeapon
Weapon <|-- ProjectileWeapon
MeleeArcWeapon <|-- SwordSlash
MeleeArcWeapon <|-- HeavyStrike
ProjectileWeapon <|-- WoodenBow
ProjectileWeapon <|-- ArcaneBolt
ProjectileWeapon <|-- ThrowingDagger
ProjectileWeapon <|-- IceShard
ProjectileWeapon <|-- SpiritSword
ProjectileWeapon <|-- BoomerangWeapon
Weapon <|-- Caltrops
Weapon <|-- OrbitingOrbs
Weapon <|-- LightningStrike
Weapon <|-- PoisonFlask
Projectile <|-- HomingProjectile
Projectile <|-- BoomerangProjectile

Enemy <|-- RangedEnemy
Enemy <|-- ChargerEnemy
Enemy <|-- ExploderEnemy
Enemy <|-- BossEnemy
BossEnemy <|-- WerebearBoss
BossEnemy <|-- NecromancerBoss

ISaveStore <|.. LocalJsonStore
ISaveStore <|.. FirestoreStore

' ===================== Composition / aggregation =====================
Player *-- "1" PlayerStats
Player *-- "1" PlayerInventory
Player *-- "1" Skill
Player --> PlayerState
PlayerInventory o-- "1..4" Weapon
PlayerInventory o-- "0..4" PassiveItem
ProjectileManager o-- "*" Projectile
DamageZoneManager o-- "*" DamageZone
EnemyManager o-- "*" Enemy
EnemyManager o-- "*" EnemyProjectile
PickupManager o-- "*" Pickup
ShopManager *-- "5" ShopSlot
RunScript *-- "*" WaveData
RunScript *-- "*" SpawnEvent
WeaponData *-- "5" WeaponLevelStats
AccountSaveData *-- "0..10" RunResult
LeaderboardEntry --> RunResult

' ===================== Associations =====================
Player --> "1" CharacterData
Weapon --> "1" WeaponData
Weapon --> "1" Player : owner
Skill --> "1" SkillData
PassiveItem --> "1" PassiveItemData
Enemy --> "1" EnemyData
Enemy --> EnemyState
Pickup --> PickupKind
UpgradeOption --> UpgradeKind
CharacterData --> WeaponData : starting weapon
CharacterData --> SkillData : starting skill
WeaponData --> PassiveItemData : evolves with
WeaponData --> AimMode
SpawnEvent --> SpawnPattern
SpawnEvent --> EnemyData
RunSelection --> CharacterData
RunSelection --> DifficultyData

GameManager --> GameState
GameManager --> "1" Player
GameManager --> "1" RunSelection
GameManager --> "1" SpawnManager
SpawnManager --> "1" RunScript
SpawnManager --> "1" DifficultyData
SpawnManager ..> EnemyManager : Spawn
SpawnManager ..> SpawnPatterns

PickupManager --> PlayerProgression
LevelUpManager --> PlayerProgression
LevelUpManager --> "1" UpgradeApplier
LevelUpManager ..> UpgradeOption : creates
LevelUpManager --> ProgressionConfig
ShopManager --> "1" UpgradeApplier
ShopManager --> PlayerProgression
ShopManager --> ShopConfig
ShopManager --> "*" ShopItemData
UpgradeApplier ..> PlayerInventory
UpgradeApplier ..> Player
RunScoreTracker --> ScoreConfig
RunScoreTracker ..> RunResult : creates

SaveService --> "1" ISaveStore : local
SaveService --> "0..1" ISaveStore : cloud
SaveService ..> RunSaveData
SaveService ..> AccountSaveData
SaveService --> GameDatabase
FirestoreStore --> AuthService
LeaderboardService --> AuthService
LeaderboardService ..> LeaderboardEntry
WeaponUnlockService --> SaveService

' ===================== Dependencies =====================
Weapon ..> DamageInfo
Weapon ..> EnemyManager : targets
ProjectileWeapon ..> ProjectileManager
ProjectileWeapon ..> PoolManager
Weapon ..> DamageZoneManager
EnemyManager ..> PoolManager
PickupManager ..> PoolManager
PickupManager ..> EnemyManager : OnEnemyDied
RunScoreTracker ..> EnemyManager : OnEnemyDied
NecromancerBoss ..> EnemyManager : summon
DamageInfo --> DamageType
PooledEffect ..> PoolManager

HudView ..> Player
HudView ..> PlayerProgression
LevelUpPanel ..> LevelUpManager
StatsPanelView ..> Player
ShopView ..> ShopManager
GameOverView ..> RunScoreTracker
GameOverView ..> LeaderboardService
LeaderboardView ..> LeaderboardService
MainMenuView ..> SaveService
CharacterSelectView ..> RunSelection
DifficultySelectView ..> RunSelection
MainMenuView ..> SceneLoader
@enduml
