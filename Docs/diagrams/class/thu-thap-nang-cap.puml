@startuml thu-thap-nang-cap
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam ArrowColor #1F5C7A
skinparam nodesep 40
skinparam ranksep 50
hide circle
hide empty members
skinparam class {
  BorderColor #1F5C7A
  BackgroundColor White
}
skinparam class<<boundary>> {
  BackgroundColor #FFF6E5
  BorderColor #C47F10
}
skinparam class<<control>> {
  BackgroundColor #EAF4EA
  BorderColor #3C8A3C
}
skinparam class<<entity>> {
  BackgroundColor #EEF6FB
  BorderColor #1F5C7A
}
skinparam class<<enum>> {
  BackgroundColor #F6F1FA
  BorderColor #7A4F9A
}
skinparam package {
  BorderColor #9AA9B3
  BackgroundColor #FCFDFE
  FontColor #1F5C7A
}

title Biểu đồ lớp - Chức năng thu thập và nâng cấp

' ============================ Thu thập =================================
package "Thu thập" {
  class PickupManager <<control>> {
    - config : ProgressionConfig
    - progression : PlayerProgression
    - gemPrefab : Pickup
    - coinPrefab : Pickup
    - active : List<Pickup>
    - gemCount : int
    - HandleEnemyDied(enemy : Enemy) : void
    - SpawnGem(position : Vector2, value : int) : void
    - TryMergeIntoNearestGem(position : Vector2, value : int) : bool
    - SpawnPickup(prefab : Pickup, position : Vector2, value : int) : Pickup
    - TickPickup(pickup, playerPosition, magnetSqr, collectSqr, step) : void
    - Collect(pickup : Pickup) : void
    - ApplyGemAppearance(gem : Pickup) : void
  }

  class Pickup <<entity>> {
    - kind : PickupKind
    + Value : int
    + IsAttracted : bool
    + Init(value : int) : void
    + AddValue(amount : int) : void
    + SetAppearance(color : Color, scale : float) : void
  }

  class GemTier <<entity>> {
    + MinValue : int
    + Color : Color
    + Scale : float
  }

  enum PickupKind <<enum>> {
    Gem
    Coin
  }
}

' ============================ Tiến trình ===============================
package "Kinh nghiệm và vàng" {
  class PlayerProgression <<control>> {
    - config : ProgressionConfig
    + Level : int
    + CurrentXP : float
    + RequiredXP : float
    + Gold : int
    + PendingLevelUps : int
    + OnXPChanged : event Action<float, float>
    + OnLevelChanged : event Action<int>
    + OnGoldChanged : event Action<int>
    + OnLevelUpReady : event Action
    + AddXP(amount : float) : void
    + AddGold(amount : int) : void
    + ConsumePendingLevelUp() : void
  }

  class ProgressionConfig <<entity>> {
    + baseRequiredXP : float
    + requiredXPPerLevel : float
    + choiceCount : int
    + maxStatCardsPerRoll : int
    + maxWeapons : int
    + maxPassives : int
    + statCards : StatCardData[]
    + fallbackHealAmount : float
    + fallbackGoldAmount : int
    + attractSpeed : float
    + collectRadius : float
    + maxGemsOnMap : int
    + gemTiers : GemTier[]
    + GetRequiredXP(level : int) : float
  }
}

' ============================ Nâng cấp =================================
package "Nâng cấp khi lên cấp" {
  class LevelUpManager <<control>> {
    - config : ProgressionConfig
    - progression : PlayerProgression
    - candidates : List<UpgradeOption>
    - evolutions : List<UpgradeOption>
    - options : List<UpgradeOption>
    - statCardPicks : Dictionary<StatCardData, int>
    + OnOptionsReady : event Action<IReadOnlyList<UpgradeOption>>
    + OnClosed : event Action
    + ChooseUpgrade(index : int) : void
    - HandleLevelUpReady() : void
    - RollOptions() : void
    - BuildCandidates() : void
    - AddEvolutionCandidates(inventory) : void
    - AddWeaponCandidates(inventory) : void
    - AddPassiveCandidates(inventory) : void
    - AddStatCardCandidates() : void
    - AddFallbackOptions() : void
    - Apply(option : UpgradeOption) : void
    - ApplyStatCard(card : StatCardData) : void
  }

  class UpgradeOption <<entity>> {
    + Kind : UpgradeKind
    + Title : string
    + Description : string
    + Icon : Sprite
    + WeaponData : WeaponData
    + Weapon : Weapon
    + PassiveData : PassiveItemData
    + Passive : PassiveItem
    + StatCard : StatCardData
    + Fallback : FallbackReward
    + {static} ForNewWeapon(data) : UpgradeOption
    + {static} ForWeaponLevel(weapon) : UpgradeOption
    + {static} ForEvolution(weapon) : UpgradeOption
    + {static} ForNewPassive(data) : UpgradeOption
    + {static} ForPassiveLevel(passive) : UpgradeOption
    + {static} ForStatCard(card) : UpgradeOption
    + {static} ForFallback(reward, title, description, icon) : UpgradeOption
  }

  enum UpgradeKind <<enum>> {
    NewWeapon
    WeaponLevel
    NewPassive
    PassiveLevel
    StatCard
    Evolution
    Fallback
  }

  enum FallbackReward <<enum>> {
    Heal
    Gold
  }
}

' ============================ Đồ của người chơi ========================
package "Đồ của người chơi" {
  abstract class Player <<control>> {
    + Stats : PlayerStats
    + Inventory : PlayerInventory
    + Character : CharacterData
    + Heal(amount : float) : void
    + ApplyStatModifier(stat : StatType, value : float, kind : StatModifierKind) : void
  }

  class PlayerInventory <<control>> {
    + Weapons : IReadOnlyList<Weapon>
    + Passives : IReadOnlyList<PassiveItem>
    + AddWeapon(data : WeaponData) : void
    + EvolveWeapon(weapon : Weapon) : void
    + AddPassive(data : PassiveItemData) : void
    + LevelUpPassive(passive : PassiveItem) : void
    + HasWeapon(data : WeaponData) : bool
    + HasPassive(data : PassiveItemData) : bool
  }

  abstract class Weapon <<control>> {
    + Data : WeaponData
    + SourceData : WeaponData
    + Level : int
    + IsMaxLevel : bool
    + CanEvolve(inventory : PlayerInventory) : bool
    + LevelUp() : void
  }

  class PassiveItem <<entity>> {
    + Data : PassiveItemData
    + Level : int
    + IsMaxLevel : bool
    + LevelUp() : void
  }

  class CharacterData <<entity>> {
    + weaponPool : WeaponData[]
    + passivePool : PassiveItemData[]
  }

  class WeaponData <<entity>> {
    + displayName : string
    + DisplayIcon : Sprite
    + MaxLevel : int
    + evolution : WeaponData
    + evolutionItem : PassiveItemData
  }

  class PassiveItemData <<entity>> {
    + stat : StatType
    + modifierKind : StatModifierKind
    + valuePerLevel : float
    + maxLevel : int
  }

  class StatCardData <<entity>> {
    + stat : StatType
    + modifierKind : StatModifierKind
    + value : float
    + maxPicks : int
    + healAmount : float
  }

  class PlayerStats <<entity>> {
    + magnet : float
    + growth : float
    + greed : float
    + ...
  }
}

' ============================ Giao diện ================================
package "Giao diện" {
  class LevelUpPanel <<boundary>> {
    - panelRoot : GameObject
    - cards : UpgradeCardView[3]
    - Show(options : IReadOnlyList<UpgradeOption>) : void
    - Hide() : void
  }

  class HudView <<boundary>> {
    - xpBar : Slider
    - goldText : TMP_Text
    - levelText : TMP_Text
    - UpdateXP(current : float, required : float) : void
    - UpdateGold(gold : int) : void
    - UpdateLevel(level : int) : void
  }

  class GameManager <<control>> {
    + EnterLevelUp() : void
    + ResumePlaying() : void
  }
}

' ============================ Quan hệ =================================
PickupManager ..> EnemyManager : OnEnemyDied
PickupManager "1" o-- "0..*" Pickup : active
Pickup --> "1" PickupKind
PickupManager ..> GemTier : màu, kích thước theo giá trị
PickupManager --> "1" ProgressionConfig
PickupManager ..> Player : Stats.magnet / growth / greed
PickupManager --> "1" PlayerProgression : AddXP / AddGold
ProgressionConfig "1" *-- "*" GemTier
ProgressionConfig "1" o-- "*" StatCardData : statCards

PlayerProgression --> "1" ProgressionConfig : GetRequiredXP
LevelUpManager --> "1" PlayerProgression : OnLevelUpReady / ConsumePendingLevelUp
LevelUpManager --> "1" ProgressionConfig
LevelUpManager ..> GameManager : EnterLevelUp / ResumePlaying
LevelUpManager "1" *-- "0..*" UpgradeOption : options
UpgradeOption --> "1" UpgradeKind
UpgradeOption --> "0..1" FallbackReward
UpgradeOption --> "0..1" WeaponData
UpgradeOption --> "0..1" Weapon
UpgradeOption --> "0..1" PassiveItemData
UpgradeOption --> "0..1" PassiveItem
UpgradeOption --> "0..1" StatCardData

LevelUpManager ..> Player : Inventory / ApplyStatModifier / Heal
LevelUpManager ..> CharacterData : weaponPool / passivePool
Player *-- "1" PlayerInventory
Player *-- "1" PlayerStats
Player --> "1" CharacterData
PlayerInventory "1" o-- "1..4" Weapon
PlayerInventory "1" o-- "0..4" PassiveItem
PlayerInventory ..> Player : ApplyStatModifier (vật phẩm)
Weapon --> "1" WeaponData
PassiveItem --> "1" PassiveItemData
WeaponData --> "0..1" WeaponData : evolution
WeaponData --> "0..1" PassiveItemData : evolutionItem
CharacterData o-- "*" WeaponData
CharacterData o-- "*" PassiveItemData

LevelUpPanel --> "1" LevelUpManager : OnOptionsReady / ChooseUpgrade
LevelUpPanel ..> UpgradeOption : hiện 3 thẻ
HudView --> "1" PlayerProgression : OnXPChanged / OnGoldChanged / OnLevelChanged

note right of PickupManager
  Quái chết → luôn rơi gem XP, có tỉ lệ rơi coin.
  Quá 300 gem trên bản đồ thì gộp vào gem gần nhất.
  Trong bán kính Magnet: gem/coin bị hút về Player;
  chạm collectRadius thì nhặt:
  XP × Growth → AddXP, vàng × Greed → AddGold.
end note

note right of LevelUpManager
  Mỗi lần lên cấp: dừng game (EnterLevelUp), bốc 3 thẻ:
  1. Có vũ khí đủ điều kiện tiến hóa → 1 thẻ EVOLVE luôn có mặt.
  2. Còn lại xáo ngẫu nhiên: nâng cấp vũ khí/vật phẩm đang có,
     vũ khí/vật phẩm mới trong pool của lớp, tối đa 1 thẻ chỉ số.
  3. Thiếu thẻ → thêm thẻ dự phòng Hồi máu / Túi vàng.
  Chọn xong: còn lượt lên cấp thì bốc tiếp, hết thì ResumePlaying.
end note

@enduml
