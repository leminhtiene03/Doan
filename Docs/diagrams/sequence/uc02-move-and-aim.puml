@startuml uc02-move-and-aim
title UC2 - Move and aim (one Player frame)
hide footbox

participant "Unity\nframe loop" as UN
participant Player as P
participant GameManager as GM
participant "Move\nInputAction" as IA
participant Mouse as MS
participant Animator as AN
participant Rigidbody2D as RB
participant HudView as HUD
participant PlayerInventory as INV

UN -> P ++ : Update()
P -> GM ++ : IsPlaying
GM --> P -- : bool
alt state == Dead or GameState != Playing
  note right of P : skip this frame
else playing
  P -> IA ++ : ReadValue()
  IA --> P -- : input
  P -> P : MoveDirection = ClampMagnitude(input, 1)
  P -> MS ++ : position
  MS --> P -- : screen position
  P -> P : AimDirection = normalize(mouse world - position)\nflipX = AimDirection.x < 0
  opt Idle / Move state changed
    P -> AN ++ : SetBool(IsMoving, MoveDirection != 0)
    AN --> P --
  end
  P -> RB ++ : linearVelocity = MoveDirection * BaseMoveSpeed * MoveSpeed
  RB --> P --
  opt Recovery > 0 and HP < MaxHP
    P -> P : Heal(Recovery * deltaTime)
    P -> HUD ++ : OnHealthChanged(current, max)
    HUD --> P --
  end
  P -> P : TickHurtFlash(deltaTime)
  P -> INV ++ : TickWeapons(deltaTime)
  ref over INV : UC4a / UC4b - attack
  INV --> P --
end
P --> UN --
@enduml
