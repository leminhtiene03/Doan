@startuml uc04b-ranged-attack
title UC4b - Ranged attack (planned)
hide footbox

participant "Player\n(Archer / Mage)" as P
participant PlayerInventory as INV
participant "WoodenBow / ArcaneBolt\n<<planned>>" as W
participant PoolManager as PM
participant "ProjectileManager\n<<planned>>" as PJM
participant "Projectile\n<<planned>>" as PR
participant EnemyManager as EM
participant Enemy as E

group Fire
  [-> P ++ : Update()
  P -> INV ++ : TickWeapons(deltaTime)
  INV -> W ++ : Tick(deltaTime)
  opt cooldownTimer <= 0
    W -> W : cooldownTimer = AttackInterval / AttackSpeed
    W -> W : count = Projectiles + Multishot\nspread in a fan around AimDirection
    loop each projectile
      W -> PM ++ : Get(projectilePrefab, position, rotation)
      PM --> W -- : projectile
      W -> PR ++ : Launch(direction, speed * ProjectileSpeed,\ndamage, DamageType, range)
      PR --> W --
      W -> PJM ++ : Register(projectile)
      PJM --> W --
      W -> P ++ : OnProjectileSpawned(projectile)
      opt Archer
        P -> PR ++ : pierce += bonusPierce
        PR --> P --
      end
      P --> W --
    end
    W -> P ++ : OnWeaponFired(weapon)
    opt Mage and random < spellEchoChance
      P -> W : fire again immediately
    end
    P --> W --
    opt PlayOwnerAttackAnim
      W -> P ++ : PlayAttackAnimation(attackInterval)
      P --> W --
    end
  end
  W --> INV --
  INV --> P --
  deactivate P
end

group Fly and hit (every frame while GameState == Playing)
  [-> PJM ++ : Update()
  loop each projectile
    PJM -> PR ++ : Tick(deltaTime)
    PR -> PR : move, travelled += step
    PR -> EM ++ : Active
    EM --> PR -- : enemies
    loop each enemy while remainingHits > 0
      opt CanBeHit, not hit by this projectile yet,\ndistance <= radius + contactRadius
        PR -> P ++ : ModifyOutgoingDamage(damage * Might)
        P --> PR -- : amount
        PR -> E ++ : TakeDamage(DamageInfo(amount, DamageType, knockback))
        E --> PR --
        PR -> PR : remember enemy\nremainingHits -= 1 (start = 1 + pierce)
      end
    end
    PR --> PJM -- : finished
    opt remainingHits == 0 or travelled >= range
      PJM -> PJM : Unregister(projectile)
      PJM -> PM ++ : Release(projectile)
      PM --> PJM --
    end
  end
  deactivate PJM
end

note over PJM, EM
  If the Profiler shows hit checks are expensive,
  add a spatial grid to EnemyManager
end note
@enduml
