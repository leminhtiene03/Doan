@startuml uc11-reroll-discard
title UC11 - Reroll the stock and discard an item (planned)
hide footbox

actor User as U
participant "ShopView\n<<planned>>" as UI
participant "ShopManager\n<<planned>>" as SM
participant PlayerProgression as PP
participant PlayerInventory as INV
participant Player as P

group Reroll
  U -> UI ++ : click Reroll
  UI -> SM ++ : Reroll()
  SM -> PP ++ : TrySpendGold(rerollCost)
  PP --> SM -- : success
  alt success
    SM -> SM : rerollCost += rerollCostStep
    SM -> SM : GenerateStock()
    ref over SM : UC10 - GenerateStock
    SM -> UI : OnStockChanged(slots)
  else not enough gold
    SM -> UI : show not enough gold
  end
  SM --> UI --
  deactivate UI
end

group Discard an owned item
  U -> UI ++ : select an owned weapon or passive
  UI -> SM ++ : RequestDiscard(item)
  alt starting weapon
    SM -> UI : reject (starting weapon cannot be discarded)
  else other item
    SM -> SM : invested = sum of price table for levels 1 to current\n(free levels included)
    SM -> UI : show confirm dialog (refund = invested * refundRatio)
  end
  SM --> UI --
  deactivate UI

  opt confirmed
    U -> UI ++ : click Confirm
    UI -> SM ++ : ConfirmDiscard(item)
    SM -> INV ++ : Remove(item)
    opt passive item
      INV -> P ++ : ApplyStatModifier(stat, -value * level, kind)
      P --> INV --
    end
    INV --> SM --
    SM -> PP ++ : AddGold(round(invested * refundRatio))
    PP --> SM --
    SM -> UI : OnInventoryChanged
    SM --> UI --
    deactivate UI
  end
end

note over SM, INV
  Removing a passive can break a weapon
  evolution condition. An evolved weapon is kept
end note
@enduml
