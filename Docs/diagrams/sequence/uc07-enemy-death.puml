@startuml uc07-enemy-death
title UC7 - Enemy death and despawn
hide footbox

participant Weapon as W
participant Enemy as E
participant Animator as AN
participant EnemyManager as EM
participant RunScoreTracker as ST
participant PickupManager as PU
participant PoolManager as PM

W -> E ++ : TakeDamage(info)
E -> E : HP -= amount * (1 - resist)
opt HP <= 0
  E -> E : Die()\nstate = Dead, stateTimer = Death clip length
  E -> AN ++ : SetTrigger(Die)
  AN --> E --
  E -> EM ++ : OnDeath(enemy)
  EM -> ST ++ : OnEnemyDied(enemy)
  ST -> ST : Kills += 1, KilledXP += XpDrop
  ST --> EM --
  EM -> PU ++ : OnEnemyDied(enemy)
  ref over PU : UC8 - drop gem and coin
  PU --> EM --
  EM --> E --
  note right of E
    CanBeHit = false
    TryContact = false
  end note
end
E --> W --

loop every frame while GameState == Playing
  [-> EM ++ : Update()
  EM -> E ++ : Tick(playerPosition, deltaTime)
  E -> E : stateTimer -= deltaTime
  E --> EM --
  EM -> E ++ : IsReadyToDespawn
  E --> EM -- : stateTimer <= 0
  opt ready to despawn
    EM -> EM : Unregister(enemy)\nmove last into ListIndex, remove last (O(1))
    EM -> PM ++ : Release(enemy)
    alt pool below max size
      PM -> E : SetActive(false)
    else pool full
      PM -> E : Destroy
    end
    PM --> EM --
  end
  deactivate EM
end

note over EM, PU
  RunScoreTracker and PickupManager both listen to OnEnemyDied.
  Their call order is not guaranteed and does not matter
end note
@enduml
