@startuml uc01-start-run
title UC1 - Choose character and difficulty, start run
hide footbox

actor User as U
participant MainMenuView as MM
participant "RunSelection\n<<ScriptableObject>>" as RS
participant SceneLoader as SL
participant CharacterSelectView as CS
participant DifficultySelectView as DS
participant GameManager as GM

[-> MM ++ : Awake()
MM -> RS ++ : Clear()
RS --> MM --
deactivate MM

U -> MM ++ : click New Game
MM -> SL ++ : LoadCharacterSelect()
SL -> SL : timeScale = 1\nLoadScene("Character")
SL --> MM --
deactivate MM

alt choose a character
  U -> CS ++ : click character button
  CS -> RS ++ : SelectCharacter(characterData)
  RS --> CS --
  CS -> SL ++ : LoadDifficultySelect()
  SL -> SL : timeScale = 1\nLoadScene("Difficute")
  SL --> CS --
  deactivate CS
else back
  U -> CS ++ : click Back
  CS -> SL ++ : LoadMainMenu()
  SL --> CS --
  deactivate CS
end

alt choose a difficulty
  U -> DS ++ : click difficulty button
  DS -> RS ++ : SelectDifficulty(difficultyData)
  RS --> DS --
  DS -> SL ++ : LoadRun()
  SL -> SL : timeScale = 1\nLoadScene("UI_InGame")
  SL -> GM ++ : Awake() (new scene)
  GM -> GM : SetState(Playing)\ntimeScale = 1, RunTime = 0
  GM --> SL --
  SL --> DS --
  deactivate DS
else back
  U -> DS ++ : click Back
  DS -> SL ++ : LoadCharacterSelect()
  SL --> DS --
  deactivate DS
end

note over RS
  ScriptableObject asset:
  the choice survives scene loads
end note
note right of GM
  Spawning the chosen character
  is planned (milestone 4)
end note
@enduml
