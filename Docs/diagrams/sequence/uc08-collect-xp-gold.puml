@startuml uc08-collect-xp-gold
title UC8 - Collect XP and gold
hide footbox

participant EnemyManager as EM
participant PickupManager as PU
participant PoolManager as PM
participant Pickup as PK
participant PlayerProgression as PP
participant HudView as HUD

group Drop
  EM -> PU ++ : OnEnemyDied(enemy)
  opt XpDrop > 0
    alt gemCount >= MaxGemsOnMap and a gem exists
      PU -> PU : find nearest gem (gem only)
      PU -> PK ++ : AddValue(XpDrop)
      PK --> PU --
      PU -> PK ++ : SetAppearance(tier color, tier scale)
      PK --> PU --
    else
      PU -> PM ++ : Get(gemPrefab, position)
      PM --> PU -- : gem
      PU -> PK ++ : Init(XpDrop)
      PK --> PU --
      PU -> PK ++ : SetAppearance(tier color, tier scale)
      PK --> PU --
      PU -> PU : gemCount += 1
    end
  end
  opt CoinAmount > 0 and random < CoinDropChance
    PU -> PM ++ : Get(coinPrefab, position)
    PM --> PU -- : coin
    PU -> PK ++ : Init(CoinAmount)
    PK --> PU --
  end
  PU --> EM --
end

group Collect (every frame while GameState == Playing)
  [-> PU ++ : Update()
  loop each pickup (last to first)
    PU -> PU : TickPickup()\nattract inside Magnet, move toward player
    opt distance <= CollectRadius
      alt gem
        PU -> PU : gemCount -= 1
        PU -> PP ++ : AddXP(value * Growth)
        PP -> HUD ++ : OnXPChanged(current, required)
        HUD --> PP --
        opt CurrentXP >= RequiredXP
          PP -> PP : Level += 1, PendingLevelUps += 1
          ref over PP : UC9 - Level up and choose upgrade
        end
        PP --> PU --
      else coin
        PU -> PP ++ : AddGold(round(value * Greed))
        PP -> HUD ++ : OnGoldChanged(gold)
        HUD --> PP --
        PP --> PU --
      end
      PU -> PU : remove from active list (swap with last, O(1))
      PU -> PM ++ : Release(pickup)
      PM --> PU --
    end
  end
  deactivate PU
end
@enduml
