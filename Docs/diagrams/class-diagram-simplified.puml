@startuml class-diagram-simplified
title Survival Action - Design class diagram (simplified)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 45
skinparam class {
  BackgroundColor White
  BorderColor #333333
  BackgroundColor<<ScriptableObject>> #FFF8E1
  BackgroundColor<<singleton>> #E8F0FE
}
hide empty members
hide circle
set separator none

package "Game.Core" {
  abstract class Entity {
    + CurrentHP : float
    + {abstract} TakeDamage(info : DamageInfo)
  }
  class GameManager <<singleton>> {
    + State : GameState
    + RunTime : float
    + EnterLevelUp()
    + OpenShop()
    + ResumePlaying()
  }
  class PoolManager <<singleton>> {
    + Get<T>(prefab, pos, rot) : T
    + Release(instance)
  }
}

package "Game.Player" {
  abstract class Player {
    + AimDirection : Vector2
    + ApplyStatModifier(stat, value, kind)
    + ModifyOutgoingDamage(damage) : float
    # {abstract} ApplyLevelPassive(level)
  }
  class "Swordsman / Archer\nMage / Guardian" as Heroes
  class PlayerStats {
    + Get(stat) : float
    + Add(stat, amount)
  }
  class PlayerInventory {
    + AddWeapon(data)
    + AddPassive(data)
    + TickWeapons(dt)
  }
  abstract class Skill {
    + Level : int
    + TryActivate() : bool
    # {abstract} Activate()
  }
  class "SwordWave / ArrowRain\nTripleFireball / SuppressionAura" as Skills
}

package "Game.Weapons" {
  abstract class Weapon {
    + Level : int
    + Tick(dt)
    + LevelUp()
    + Evolve(evolved)
    # {abstract} Attack(direction)
  }
  abstract class MeleeArcWeapon
  abstract class ProjectileWeapon
  class "Caltrops / OrbitingOrbs\nLightningStrike / PoisonFlask" as OtherWeapons
  class Projectile {
    + Launch(dir, speed, damage, type, range)
    + Tick(dt) : bool
  }
  class DamageZone {
    + Tick(dt) : bool
  }
}

package "Game.Enemies" {
  class Enemy {
    + Init(data, difficulty)
    + Tick(playerPos, dt)
    + TryContact(playerPos) : bool
  }
  class "Ranged / Charger / Exploder\nWerebear / Necromancer" as SpecialEnemies
  class EnemyManager <<singleton>> {
    + Active : IReadOnlyList<Enemy>
    + Spawn(data, pos) : Enemy
    + FindNearest(from, range) : Enemy
  }
  class SpawnManager {
    + Tick(runTime, dt)
  }
}

package "Game.Progression" {
  class PlayerProgression {
    + Level : int
    + Gold : int
    + AddXP(amount)
    + TrySpendGold(amount) : bool
  }
  class PickupManager
  class LevelUpManager {
    + ChooseUpgrade(index)
  }
  class UpgradeApplier {
    + Apply(option)
  }
  class RunScoreTracker {
    + CalculateScore(time, victory) : int
  }
}

package "Game.Shop" {
  class ShopManager {
    + Buy(slot)
    + Reroll()
  }
}

package "Game.Save" {
  class SaveService {
    + SaveRunAndExit()
    + LoadRun() : RunSaveData
  }
  interface ISaveStore
  class "LocalJsonStore / FirestoreStore" as Stores
  class LeaderboardService {
    + SubmitResult(result)
  }
}

package "Game.Data" {
  class CharacterData <<ScriptableObject>>
  class WeaponData <<ScriptableObject>>
  class EnemyData <<ScriptableObject>>
  class RunScript <<ScriptableObject>>
}

Entity <|-- Player
Entity <|-- Enemy
Player <|-- Heroes
Skill <|-- Skills
Weapon <|-- MeleeArcWeapon
Weapon <|-- ProjectileWeapon
Weapon <|-- OtherWeapons
Enemy <|-- SpecialEnemies
ISaveStore <|.. Stores

Player *-- "1" PlayerStats
Player *-- "1" PlayerInventory
Player *-- "1" Skill
PlayerInventory o-- "1..4" Weapon
EnemyManager o-- "*" Enemy

Player --> CharacterData
Weapon --> WeaponData
Enemy --> EnemyData
SpawnManager --> RunScript
SaveService --> ISaveStore

ProjectileWeapon ..> Projectile
OtherWeapons ..> DamageZone
Weapon ..> EnemyManager : targets
EnemyManager ..> PoolManager
GameManager --> SpawnManager
SpawnManager ..> EnemyManager : Spawn
PickupManager ..> EnemyManager : OnEnemyDied
PickupManager --> PlayerProgression
LevelUpManager --> PlayerProgression
LevelUpManager --> UpgradeApplier
ShopManager --> UpgradeApplier
ShopManager --> PlayerProgression
UpgradeApplier ..> PlayerInventory
RunScoreTracker ..> EnemyManager : OnEnemyDied
LeaderboardService ..> RunScoreTracker : result

PlayerProgression -[hidden]down- Weapon
UpgradeApplier -[hidden]down- Projectile
SaveService -[hidden]down- ShopManager
ShopManager -[hidden]down- LeaderboardService

note "UI (HudView, LevelUpPanel, ShopView, ...) only listens to events; omitted.\nProjectileManager / DamageZoneManager tick Projectile / DamageZone; omitted.\nFull diagram: class-diagram.puml" as N1
@enduml
