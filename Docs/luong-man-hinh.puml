@startuml luong-man-hinh
skinparam shadowing false
skinparam state {
  BackgroundColor White
  BorderColor #333333
  BackgroundColor<<planned>> #F2F2F2
  BorderColor<<planned>> #999999
  FontColor<<planned>> #666666
}
hide empty description

state "Main Menu" as Menu
state "Option\n(âm lượng SFX / BGM)" as Option
state "Nhập tên người chơi" as Name
state "Chọn nhân vật" as Character
state "Chọn độ khó" as Difficulty

state "Màn chơi" as Run {
  state "HUD\n(máu, cấp, vàng, thời gian, XP)" as HUD
  state "Bảng lên cấp\n(chọn 1 trong 3 thẻ)" as LevelUp
  state "Bảng chỉ số" as Stats
  state "Shop" as Shop <<planned>>

  [*] --> HUD
  HUD --> LevelUp : đủ XP
  LevelUp --> HUD : chọn thẻ\n(hết lượt lên cấp)
  HUD --> Stats : giữ Tab
  Stats --> HUD : thả Tab
  HUD --> Shop : phút 10:00 / 20:00
  Shop --> HUD : Tiếp tục\n(đếm ngược 3-2-1)
}

state "Game Over\n(điểm, hạng, bảng xếp hạng)" as GameOver
state "Victory" as Victory <<planned>>

[*] --> Menu
Menu --> Name : NEW GAME
Menu --> Shop : CONTINUE\n(nạp ván đã lưu)
Menu --> Option : OPTION
Option --> Menu : Quay lại
Menu --> [*] : EXIT

Name --> Character : Xác nhận tên
Character --> Difficulty : Chọn nhân vật
Difficulty --> Run : Chọn độ khó

Run --> GameOver : HP về 0, hết hồi sinh
Run --> Victory : hạ Necromancer (phút 30)
Shop --> Menu : Lưu và thoát

GameOver --> Run : Retry\n(cùng nhân vật, độ khó)
GameOver --> Menu : Exit
Victory --> Menu : Exit

note right of Shop
  Shop, Victory và CONTINUE
  chưa có code (planned)
end note
@enduml
