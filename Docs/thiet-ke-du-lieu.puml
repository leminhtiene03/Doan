@startuml thiet-ke-du-lieu
title Biểu đồ lớp phân tích - dữ liệu lưu trữ

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor White
  BorderColor #333333
  BackgroundColor<<danh mục>> #F2F2F2
  BorderColor<<danh mục>> #999999
}
hide circle
hide empty methods

package "Tài khoản (Firestore: users)" {
  class "Tài khoản" as Account {
    userId : string <<PK>>
    displayName : string
    accountGold : int
    createdAt : datetime
    lastPlayedAt : datetime
  }
  class "Cài đặt" as Settings {
    bgmVolume : float
    sfxVolume : float
  }
  class "Vũ khí đã mở khóa" as Unlock {
    weaponId : string <<FK>>
    unlockedAt : datetime
  }
}

package "Kết quả và xếp hạng" {
  class "Kết quả ván" as RunResult {
    runId : string <<PK>>
    userId : string <<FK>>
    characterId : string <<FK>>
    difficultyId : string <<FK>>
    score : int
    runTime : float
    kills : int
    level : int
    victory : bool
    finishedAt : datetime
  }
  class "Mục xếp hạng" as Leaderboard {
    userId : string <<PK, FK>>
    difficultyId : string <<PK, FK>>
    displayName : string
    bestScore : int
    runId : string <<FK>>
    updatedAt : datetime
  }
}

package "Ván đang lưu (lưu ở Shop)" {
  class "Ván đang lưu" as RunSave {
    userId : string <<PK, FK>>
    version : int
    savedAt : datetime
    characterId : string <<FK>>
    difficultyId : string <<FK>>
    runTime : float
    nextShopIndex : int
    positionX : float
    positionY : float
    currentHP : float
    level : int
    currentXP : float
    runGold : int
    stats : float[15]
  }
  class "Vũ khí trong ván" as RunWeapon {
    weaponId : string <<FK>>
    level : int
    isEvolved : bool
  }
  class "Vật phẩm trong ván" as RunPassive {
    passiveId : string <<FK>>
    level : int
  }
  class "Kỹ năng trong ván" as RunSkill {
    level : int
    isEvolved : bool
    cooldownRemaining : float
  }
  class "Quái trên bản đồ" as RunEnemy {
    enemyId : string <<FK>>
    positionX : float
    positionY : float
    currentHP : float
  }
  class "Vật phẩm rơi" as RunPickup {
    kind : Gem | Coin | Chest
    positionX : float
    positionY : float
    value : int
  }
  class "Trạng thái Shop" as RunShop {
    rerollCost : int
    slotItemIds : string[5]
    soldSlots : bool[5]
    boughtCounts : map<string, int>
  }
}

package "Danh mục (dữ liệu tĩnh trong game, không lưu DB)" {
  class "Nhân vật" as Character <<danh mục>> {
    characterId : string <<PK>>
  }
  class "Độ khó" as Difficulty <<danh mục>> {
    difficultyId : string <<PK>>
  }
  class "Vũ khí" as Weapon <<danh mục>> {
    weaponId : string <<PK>>
  }
  class "Vật phẩm bị động" as Passive <<danh mục>> {
    passiveId : string <<PK>>
  }
  class "Quái" as Enemy <<danh mục>> {
    enemyId : string <<PK>>
  }
}

Account "1" *-- "1" Settings
Account "1" *-- "0..*" Unlock : mở khóa
Unlock "0..*" --> "1" Weapon

Account "1" -- "0..*" RunResult : chơi
RunResult "0..*" --> "1" Character
RunResult "0..*" --> "1" Difficulty

Account "1" -- "0..3" Leaderboard : xếp hạng
Leaderboard "0..1" --> "1" RunResult : ván điểm cao nhất
Leaderboard "0..*" --> "1" Difficulty

Account "1" -- "0..1" RunSave : lưu
RunSave "0..*" --> "1" Character
RunSave "0..*" --> "1" Difficulty
RunSave "1" *-- "1..4" RunWeapon
RunSave "1" *-- "0..4" RunPassive
RunSave "1" *-- "1" RunSkill
RunSave "1" *-- "0..*" RunEnemy
RunSave "1" *-- "0..*" RunPickup
RunSave "1" *-- "1" RunShop
RunWeapon "0..*" --> "1" Weapon
RunPassive "0..*" --> "1" Passive
RunEnemy "0..*" --> "1" Enemy
@enduml
