@startuml thiet-ke-csdl-firestore
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ArrowColor #1F5C7A
skinparam nodesep 40
skinparam ranksep 50
hide circle
hide stereotype
hide empty methods
skinparam class {
  BorderColor #1F5C7A
  BackgroundColor White
  AttributeFontColor Black
}
skinparam class<<auth>> {
  BackgroundColor #FFF4E0
  BorderColor #C47F10
}
skinparam class<<embedded>> {
  BackgroundColor #F2F2F2
  BorderColor #777777
}
skinparam class<<planned>> {
  BackgroundColor #FFFFFF
  BorderColor #9AA9B3
  BorderStyle dashed
  FontColor #555555
}
skinparam package {
  BorderColor #1F5C7A
  BackgroundColor #F4FAFD
  FontColor #1F5C7A
}

title Thiết kế cơ sở dữ liệu (Firebase Authentication + Cloud Firestore)

package "Firebase Authentication" {
  class "Tài khoản xác thực" as AuthUser <<auth>> {
    uid : string <<PK>>
    email : string <<unique, rỗng nếu là khách>>
    passwordHash : string <<Firebase quản lý>>
    displayName : string
    isAnonymous : bool
    isEmailVerified : bool
    providers : {password, anonymous}
  }
}

package "Cloud Firestore" {
  class "users/{uid}" as User {
    uid : string <<PK = id document, FK>>
    displayName : string
    createdAt : timestamp
    updatedAt : timestamp
    version : int
    accountGold : int
    unlockedWeaponIds : array<string>
    recentRuns : array<RunResult> <<tối đa 10>>
    settings : map<SettingsData> <<dự kiến>>
  }

  class "RunResult" as RunResult <<embedded>> {
    score : int
    runTime : float
    kills : int
    level : int
    victory : bool
    difficultyId : string
    characterId : string
    timestamp : string <<UTC, ISO 8601>>
  }

  class "SettingsData" as Settings <<planned>> {
    bgmVolume : float
    sfxVolume : float
    showHealthBar : bool
  }

  class "users/{uid}/runSave/current" as RunSave <<planned>> {
    version : int
    savedAt : timestamp
    characterId : string
    difficultyId : string
    runTime : float
    json : string <<RunSaveData dạng JSON>>
  }

  class "leaderboard/{uid}" as Leaderboard <<planned>> {
    uid : string <<PK = id document, FK>>
    displayName : string
    score : int <<sắp xếp giảm dần>>
    difficultyId : string
    characterId : string
    runTime : float
    kills : int
    level : int
    victory : bool
    achievedAt : timestamp
  }
}

AuthUser "1" -- "1" User : uid
User "1" *-- "0..10" RunResult : nhúng trong recentRuns
User "1" *-- "0..1" Settings : nhúng trong settings
User "1" *-- "0..1" RunSave : sub-collection\n(1 ô lưu duy nhất)
User "1" -- "0..1" Leaderboard : kết quả tốt nhất

note right of AuthUser
  Đăng nhập email + mật khẩu hoặc chơi khách (ẩn danh).
  Khách liên kết email: uid giữ nguyên, dữ liệu giữ nguyên.
  Code: Scripts/Online/AuthService.cs
end note

note bottom of User
  Tạo ở lần đăng nhập đầu tiên, updatedAt cập nhật mỗi lần đăng nhập.
  Code: Scripts/Online/UserProfileService.cs
  Luật bảo mật: chỉ chủ tài khoản (request.auth.uid == uid) được đọc/ghi.
end note

note bottom of Leaderboard
  Ai cũng đọc được; chỉ chủ tài khoản ghi,
  và chỉ khi score mới lớn hơn score cũ.
end note

legend right
  |= Ký hiệu |= Ý nghĩa |
  | Khung viền liền | Đã cài đặt trong code |
  | Khung viền đứt | Dự kiến (mốc 7–8), đã có trong thiet-ke-luu-tru.md |
  | Nền xám | Kiểu dữ liệu nhúng (map), không phải document riêng |
endlegend

@enduml
